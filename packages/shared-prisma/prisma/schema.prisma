// ─────────────────────────────────────────
// CONFIGURACIÓN DE PRISMA
// ─────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), uuid_ossp(map: "uuid-ossp"), pgcrypto]
}

// ─────────────────────────────────────────
// ENUMS GLOBALES
// ─────────────────────────────────────────

enum ClinicPlan {
  STARTER
  PRO
}

enum IntegrationType {
  WHATSAPP
  INSTAGRAM
  GOOGLE_CALENDAR
  DENTALINK
  DENTIDESK
  GMAIL
}

/// Cómo opera el agente con los pacientes.
/// AUTONOMOUS: responde y gestiona la agenda.
/// SUPERVISED: responde dudas, pero no agenda, reprograma ni cancela.
/// PAUSED: no responde; las conversaciones quedan para el equipo.
enum AgentMode {
  AUTONOMOUS
  SUPERVISED
  PAUSED
}

enum MessageRole {
  USER
  ASSISTANT
  HUMAN
  SYSTEM
}

enum ConversationStatus {
  OPEN
  HUMAN_TAKEOVER
  CLOSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  /// Asistió. Lo marca la clínica en la agenda: no hay integración con su
  /// sistema de fichas que lo traiga solo.
  COMPLETED
  /// No asistió y no avisó.
  NO_SHOW
}

enum AppointmentSource {
  AGENT
  HUMAN
  EXTERNAL
}

enum MetricEventType {
  CONVERSATION_STARTED
  CONVERSATION_CLOSED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  HUMAN_TAKEOVER
  OUT_OF_HOURS
  INTENTION_DETECTED
}

// ─────────────────────────────────────────
// 1. MÓDULO DEVIATY MASTER
// ─────────────────────────────────────────

model Clinic {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  slug         String     @unique
  plan         ClinicPlan @default(STARTER)
  active       Boolean?   @default(true)
  /// Clínica interna de la plataforma: aloja las cuentas del equipo Dentral
  /// (cada usuario tiene que pertenecer a una clínica). No es una clínica de
  /// verdad: no aparece en el backoffice ni atiende pacientes.
  internal     Boolean    @default(false)
  billingEmail String     @map("billing_email")
  commercial   ClinicCommercial?
  agentTurns   AgentTurn[]
  /// Lo que la plataforma le habilita (módulos del panel, agente, canales,
  /// acciones, recordatorios). Solo se edita desde el backoffice. Vacío =
  /// todo permitido. Ver accesos.util en shared-utils.
  entitlements Json       @default("{}")
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  roles                Role[]
  users                User[]
  integrations         ClinicIntegration[]
  agentConfig          AgentConfig?
  auditLogs            AuditLog[]
  platformMetrics      PlatformMetric[]
  configs              ClinicConfig?
  schedules            ClinicSchedule[]
  unavailabilityBlocks UnavailabilityBlock[]
  policies             Policy[]
  doctors              Doctor[]
  doctorSchedules DoctorSchedule[]
  doctorAbsences  DoctorAbsence[]
  treatments           Treatment[]
  offers               TreatmentOffer[]
  appointments         Appointment[]
  contacts             ClinicContact[]
  conversations        Conversation[]
  messages             Message[]
  patientSessions      PatientSession[]
  metricsEvents        MetricsEvent[]
  knowledgeOverrides   ClinicKnowledgeOverride[]

  @@map("clinics")
}

model Role {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  name         String
  isSuperadmin Boolean?  @default(false) @map("is_superadmin")
  permissions  Json      @default("{}")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])
  users  User[]

  @@map("roles")
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId      String    @map("clinic_id") @db.Uuid
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  inviteToken   String?   @map("invite_token")
  inviteExpires DateTime? @map("invite_expires") @db.Timestamptz
  roleId        String    @map("role_id") @db.Uuid
  /// Superusuario de la plataforma (el equipo de Deviaty), no de una clínica.
  /// Entra al backoffice y puede actuar sobre cualquier clínica. Se asigna a
  /// mano en la base de datos: ningún endpoint lo concede.
  platformAdmin Boolean   @default(false) @map("platform_admin")
  active        Boolean?  @default(true)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  conversations Conversation[] @relation("AssignedOperator")
  doctor        Doctor?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model ClinicIntegration {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId     String          @map("clinic_id") @db.Uuid
  type         IntegrationType
  connected    Boolean?        @default(false)
  credentials  Json?
  /// Identificador del recurso en el proveedor, en claro para poder buscarlo.
  /// En WhatsApp es el phone_number_id: con él se sabe a qué clínica va cada
  /// mensaje entrante. Único: un número no puede atender a dos clínicas.
  externalId   String?         @unique @map("external_id")
  lastTestedAt DateTime?       @map("last_tested_at") @db.Timestamptz
  lastTestOk   Boolean?        @map("last_test_ok")
  updatedAt    DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, type])
  @@map("clinic_integrations")
}

model AgentConfig {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @unique @map("clinic_id") @db.Uuid
  actions   Json      @default("{}")
  mode      AgentMode @default(AUTONOMOUS)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("agent_configs")
}

model AuditLog {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @map("clinic_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String    @map("entity_id") @db.Uuid
  changes   Json      @default("{}")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

model PlatformMetric {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId   String    @map("clinic_id") @db.Uuid
  metricType String    @map("metric_type")
  value      Float
  recordedAt DateTime? @default(now()) @map("recorded_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, metricType, recordedAt])
  @@map("platform_metrics")
}

// ─────────────────────────────────────────
// 2. MÓDULO CONFIGURACIÓN CLÍNICA
// ─────────────────────────────────────────

model ClinicConfig {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @unique @map("clinic_id") @db.Uuid
  name      String
  address   String
  phone     String
  email     String
  timezone  String
  language  String    @default("es")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_configs")
}

model ClinicSchedule {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  isOpen    Boolean? @default(true) @map("is_open")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_schedules")
}

model UnavailabilityBlock {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId   String    @map("clinic_id") @db.Uuid
  name       String
  daysOfWeek Int[]     @map("days_of_week")
  startTime  String    @map("start_time")
  endTime    String    @map("end_time")
  active     Boolean?  @default(true)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("unavailability_blocks")
}

model Policy {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId    String    @map("clinic_id") @db.Uuid
  title       String
  description String
  active      Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("policies")
}

model Doctor {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @map("clinic_id") @db.Uuid
  name      String
  title     String
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  /// Cuenta con la que el profesional entra a la plataforma. Es opcional: una
  /// ficha de doctor puede existir sin que esa persona tenga acceso, que es la
  /// situación de todos los doctores creados antes de esta función.
  userId String? @unique @map("user_id") @db.Uuid

  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  treatments   DoctorTreatment[]
  appointments Appointment[]
  schedules    DoctorSchedule[]
  absences     DoctorAbsence[]

  @@map("doctors")
}

/// Jornada semanal de un profesional. Admite VARIOS tramos por día, que es como
/// se representa una jornada partida (mañana y tarde) y también una ausencia
/// recurrente: "los viernes no atiendo por la tarde" es, simplemente, un viernes
/// con solo el tramo de mañana. Así no hay dos fuentes de verdad para lo mismo.
///
/// El horario de la clínica sigue siendo el límite exterior: estos tramos pueden
/// recortar dentro de él, nunca ampliarlo.
model DoctorSchedule {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @map("clinic_id") @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  dayOfWeek Int       @map("day_of_week")
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([clinicId, doctorId])
  @@map("doctor_schedules")
}

/// Ausencia con fecha concreta: desde un par de horas sueltas hasta unas
/// vacaciones de dos semanas. Un rango de instantes cubre los dos casos sin
/// necesidad de modelos distintos; `allDay` solo sirve para pintarlo bien en la
/// interfaz, no cambia el cálculo.
model DoctorAbsence {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId  String    @map("clinic_id") @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  startsAt  DateTime  @map("starts_at") @db.Timestamptz
  endsAt    DateTime  @map("ends_at") @db.Timestamptz
  allDay    Boolean?  @default(false) @map("all_day")
  reason    String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, startsAt])
  @@map("doctor_absences")
}

/// Pregunta que el agente hace antes de reservar ese tratamiento, y su
/// respuesta en la cita. Nace de la endodoncia, que cambia según la pieza, pero
/// se deja configurable en vez de escribir "Endodoncia" en el código: mañana la
/// clínica querrá preguntar otra cosa en otro tratamiento.
model Treatment {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId        String    @map("clinic_id") @db.Uuid
  name            String
  category        String
  durationAvgMin  Int?      @map("duration_avg_min")
  encyclopediaRef String?   @map("encyclopedia_ref") @db.Uuid
  active          Boolean?  @default(true)
  // Campos que la API/front usan directamente sobre el tratamiento
  description     String?
  durationMin     Int?      @map("duration_min")
  price           Int?
  priceIsapre     Int?      @map("price_isapre")
  priceFonasa     Int?      @map("price_fonasa")
  acceptsIsapre   Boolean?  @default(false) @map("accepts_isapre")
  acceptsFonasa   Boolean?  @default(false) @map("accepts_fonasa")
  /// Pregunta que el agente debe hacer antes de reservar este tratamiento, por
  /// ejemplo "¿de qué diente?" en una endodoncia. Vacío = no pregunta nada.
  extraQuestion   String?   @map("extra_question")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic       Clinic            @relation(fields: [clinicId], references: [id])
  doctors      DoctorTreatment[]
  offers       TreatmentOffer[]
  appointments Appointment[]

  @@index([clinicId, active])
  @@map("treatments")
}

model DoctorTreatment {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId    String @map("clinic_id") @db.Uuid
  doctorId    String @map("doctor_id") @db.Uuid
  treatmentId String @map("treatment_id") @db.Uuid

  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@unique([doctorId, treatmentId])
  @@map("doctor_treatments")
}

model TreatmentOffer {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId    String    @map("clinic_id") @db.Uuid
  treatmentId String    @map("treatment_id") @db.Uuid
  label       String
  price       Int?
  discountPct Int?      @map("discount_pct")
  fixedPrice  Int?      @map("fixed_price")
  active      Boolean?  @default(true)
  validFrom   DateTime? @map("valid_from") @db.Timestamptz
  validUntil  DateTime? @map("valid_until") @db.Timestamptz
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@map("treatment_offers")
}

model Appointment {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId       String            @map("clinic_id") @db.Uuid
  contactId      String?           @map("contact_id") @db.Uuid
  treatmentId    String?           @map("treatment_id") @db.Uuid
  doctorId       String?           @map("doctor_id") @db.Uuid
  conversationId String?           @map("conversation_id") @db.Uuid
  contactName    String?           @map("contact_name")
  scheduledAt    DateTime          @map("scheduled_at") @db.Timestamptz
  durationMin    Int               @map("duration_min")
  status         AppointmentStatus @default(PENDING)
  source         AppointmentSource @default(AGENT)
  externalId     String?           @map("external_id")
  notes          String?
  /// Referencia corta que se le da al paciente ("D4K7QP"). El UUID no sirve
  /// para eso: nadie lo dicta por WhatsApp ni lo reconoce al leerlo.
  code           String?           @unique
  /// Respuesta a la pregunta del tratamiento, p. ej. la pieza en una endodoncia.
  extraAnswer    String?           @map("extra_answer")
  reminder3dSent Boolean?          @default(false) @map("reminder_3d_sent")
  reminder1dSent Boolean?          @default(false) @map("reminder_1d_sent")
  reminder1hSent Boolean?          @default(false) @map("reminder_1h_sent")
  createdAt      DateTime?         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic       Clinic               @relation(fields: [clinicId], references: [id])
  contact      ClinicContact?       @relation(fields: [contactId], references: [id])
  treatment    Treatment?           @relation(fields: [treatmentId], references: [id])
  doctor       Doctor?              @relation(fields: [doctorId], references: [id])
  conversation Conversation?        @relation(fields: [conversationId], references: [id])
  history      AppointmentHistory[]

  @@index([clinicId, scheduledAt])
  @@index([clinicId, status])
  @@map("appointments")
}

model AppointmentHistory {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  event         String
  payload       Json?     @default("{}")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId, createdAt])
  @@map("appointment_history")
}

// ─────────────────────────────────────────
// 3. MÓDULO OPERATIVO
// ─────────────────────────────────────────

model ClinicContact {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId          String    @map("clinic_id") @db.Uuid
  phone             String?
  email             String?
  instagramUser     String?   @map("instagram_user")
  /// Nombre de pila. Se mantiene el campo histórico: hasta ahora guardaba el
  /// nombre completo y hay datos con ese formato.
  name              String?
  lastName          String?   @map("last_name")
  /// RUT normalizado a "12345678-9": sin puntos y con el dígito en mayúscula,
  /// para que el mismo paciente no entre dos veces por escribirlo distinto.
  rut               String?
  address           String?
  lastInteractionAt DateTime? @map("last_interaction_at") @db.Timestamptz
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  conversations Conversation[]
  appointments  Appointment[]

  @@index([clinicId, phone])
  @@index([clinicId, instagramUser])
  @@map("clinic_contacts")
}

model Conversation {
  id             String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId       String             @map("clinic_id") @db.Uuid
  contactId      String?            @map("contact_id") @db.Uuid
  channel        String
  status         ConversationStatus @default(OPEN)
  currentStep    String             @default("inicio") @map("current_step")
  assignedUserId String?            @map("assigned_user_id") @db.Uuid
  startedAt      DateTime?          @default(now()) @map("started_at") @db.Timestamptz
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz

  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  contact         ClinicContact?   @relation(fields: [contactId], references: [id])
  assignedTo      User?            @relation("AssignedOperator", fields: [assignedUserId], references: [id])
  messages        Message[]
  appointments    Appointment[]
  patientSessions PatientSession[]
  metricsEvents   MetricsEvent[]
  metadata        Json?            @default("{}")

  @@index([clinicId, status])
  @@index([contactId])
  @@index([clinicId, startedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  clinicId       String      @map("clinic_id") @db.Uuid
  role           MessageRole
  content        String
  langchainMeta  Json?       @default("{}") @map("langchain_meta")
  sentAt         DateTime?   @default(now()) @map("sent_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])

  @@index([conversationId, sentAt])
  @@map("messages")
}

model PatientSession {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId       String   @map("clinic_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  rut            String
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([expiresAt])
  @@map("patient_sessions")
}

model MetricsEvent {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId       String          @map("clinic_id") @db.Uuid
  eventType      MetricEventType @map("event_type")
  conversationId String?         @map("conversation_id") @db.Uuid
  value          Json?           @default("{}")
  certainty      Float?
  intention      String?
  hourOfDay      Int?            @map("hour_of_day")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamptz

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([clinicId, eventType, createdAt])
  @@index([clinicId, hourOfDay])
  @@map("metrics_events")
}

// ─────────────────────────────────────────
// 4. MÓDULO RAG
// ─────────────────────────────────────────

model DentalEntry {
  id                String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String
  category          String
  description       String
  procedure         String
  durationAvgMin    Int?                        @map("duration_avg_min")
  indications       String[]
  contraindications String[]
  postCare          String[]                    @map("post_care")
  keywords          String[]
  embedding         Unsupported("vector(1536)")
  updatedAt         DateTime?                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("dental_entries")
}

model ClinicKnowledgeOverride {
  id                String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId          String                      @map("clinic_id") @db.Uuid
  dentalEntryRef    String?                     @map("dental_entry_ref") @db.Uuid
  name              String
  category          String
  customProcedure   String?                     @map("custom_procedure")
  customPostCare    String[]                    @map("custom_post_care")
  customIndications String[]                    @map("custom_indications")
  customNotes       String?                     @map("custom_notes")
  active            Boolean?                    @default(true)
  embedding         Unsupported("vector(1536)")
  createdAt         DateTime?                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime?                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, active])
  @@map("clinic_knowledge_overrides")
}

// ─────────────────────────────────────────
// MÉTRICAS DE IMPACTO Y TELEMETRÍA
// ─────────────────────────────────────────

/// Condiciones comerciales y línea base de una clínica. La carga el equipo de
/// la plataforma en el backoffice antes del piloto. Sin esto no hay ingreso
/// estimado ni garantía que calcular: ambos dependen del ticket promedio.
model ClinicCommercial {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId              String    @unique @map("clinic_id") @db.Uuid
  /// Mensualidad en USD (99 por sucursal).
  monthlyFeeUsd         Float     @default(99) @map("monthly_fee_usd")
  /// Ticket promedio de primera consulta o tratamiento, en la moneda de la clínica.
  avgTicket             Float?    @map("avg_ticket")
  currency              String    @default("CLP")
  /// Cuántas unidades de la moneda local vale 1 USD. Convierte la mensualidad
  /// para compararla con el ingreso de la clínica.
  usdRate               Float     @default(950) @map("usd_rate")
  pilotStartedAt        DateTime? @map("pilot_started_at") @db.Timestamptz
  // Línea base previa al piloto (semanas -2 a 0, sacada de su sistema de fichas).
  weeklyAppointments    Float?    @map("weekly_appointments")
  /// 0.25 = 25 %.
  noShowRate            Float?    @map("no_show_rate")
  lostConsultationsWeek Int?      @map("lost_consultations_week")
  firstResponseTimeSec  Int?      @map("first_response_time_sec")
  receptionHoursWeek    Float?    @map("reception_hours_week")
  updatedAt             DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("clinic_commercials")
}

/// Un turno del agente: un mensaje del paciente y lo que pasó con él. Es la
/// telemetría de la plataforma: latencia, cola, tokens, costo y desenlace.
model AgentTurn {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  conversationId   String?   @map("conversation_id") @db.Uuid
  channel          String
  simulated        Boolean   @default(false)
  /// replied | paused | blocked | takeover | loop | error
  outcome          String
  intent           String?
  model            String?
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  costUsd          Float     @default(0) @map("cost_usd")
  /// Tiempo dentro del modelo (clasificador + agente).
  llmMs            Int?      @map("llm_ms")
  /// Desde que el paciente envió el mensaje (marca de Meta) hasta que salió la respuesta.
  endToEndMs       Int?      @map("end_to_end_ms")
  /// Espera en la cola de BullMQ.
  queueMs          Int?      @map("queue_ms")
  /// Lo que tardó el webhook en aceptar el mensaje de Meta.
  webhookMs        Int?      @map("webhook_ms")
  /// El modelo devolvió algo que no era el JSON esperado.
  parseError       Boolean   @default(false) @map("parse_error")
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, createdAt])
  @@index([createdAt])
  @@map("agent_turns")
}
