# ==========================================================================
# Plantilla de variables de entorno. Copia a `.env` y rellena con valores
# REALES en cada entorno. NUNCA comitees el .env real (está en .gitignore).
# Genera los secretos con:  openssl rand -hex 32
# ==========================================================================

# --- Base de datos (Postgres del docker-compose o externo) ---
# En docker-compose el hostname interno es 'postgres'
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/deviatyhub
DIRECT_URL=
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=deviatyhub

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth / JWT (secretos separados; genera valores nuevos por entorno) ---
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- IA (AmalIA) ---
OPENAI_API_KEY=
# Modelo del agente. Vacío = gpt-4o-mini. Un modelo mayor comete bastantes
# menos invenciones en el razonamiento sobre fechas y disponibilidad.
OPENAI_MODEL=
# El clasificador de intención puede ir en uno más barato: su salida es una
# etiqueta de un catálogo cerrado, no texto que lea un paciente.
OPENAI_CLASSIFIER_MODEL=
# Solo para modelos de razonamiento (gpt-5, o1...). Vacío = minimal.
# Medido con nuestro prompt: por defecto 28,8s por llamada; con minimal, 4,0s.
OPENAI_REASONING_EFFORT=

# --- WhatsApp Meta API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_WEBHOOK_SECRET=CHANGE_ME

# --- Notificaciones (Gmail) ---
GMAIL_USER=
GMAIL_PASS=

# Cada cuántos minutos se revisan los recordatorios de citas. Vacío = 5.
REMINDER_INTERVAL_MIN=
